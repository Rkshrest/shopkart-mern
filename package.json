    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9"
  }
}
